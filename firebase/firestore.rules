rules_version = '2';

// WebWander security rules.
//  - Anyone can read approved sites and public stats.
//  - Signed-in users own everything under users/{uid} (history, saved sites, preferences)
//    and can submit URLs for review. No user can see another user's data.
//  - Admins (a doc at admins/{uid}) review the queue and edit sites.
//  - The crawler uses the Admin SDK (service account), which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /sites/{id} {
      allow get, list: if resource.data.status == 'approved' || isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'categories', 'title', 'description', 'frameable',
                  'approvedAt', 'approvedBy', 'reviewedAt', 'rand']);
      allow delete: if isAdmin();
    }

    match /submissions/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.url is string
        && request.resource.data.url.size() > 3
        && request.resource.data.url.size() < 500
        && (request.resource.data.keys().hasOnly(['url', 'uid', 'createdAt'])
            || (isAdmin() && request.resource.data.keys().hasOnly(['url', 'uid', 'createdAt', 'autoApprove'])));
      allow read, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
    }

    match /meta/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
